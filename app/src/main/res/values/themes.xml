<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PokeApp" parent="Theme.Material3.DayNight.NoActionBar" />
    <style name="Theme.PokeApp" parent="Base.Theme.PokeApp" />

    <style name="MenuButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_height">176dp</item>
        <item name="android:background">@drawable/bg_hexagono</item>
        <item name="android:backgroundTint">@null</item>

        <!-- VARIABLE INTELIGENTE: Casi negro de día, Blanco suave de noche -->
        <item name="android:textColor">?android:attr/textColorPrimary</item>

        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">0dp</item>
    </style>
</resources>