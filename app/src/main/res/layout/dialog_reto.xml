<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡NUEVO RETO!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#F44336"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtMensajeReto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡El Entrenador RIVAL te ha desafiado!"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAceptarReto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="¡Aceptar y Preparar Equipo!"
            android:background="@drawable/bg_hexagono2"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRechazarReto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Rechazar"
            android:background="@drawable/bg_hexagono2"
            android:backgroundTint="#888888"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>