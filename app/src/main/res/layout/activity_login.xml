<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_pokeapp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Tu logo personalizado -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/icon_pokeapp"
            android:layout_marginBottom="32dp"
            android:elevation="8dp"/>

        <!-- Tarjeta de Login Adaptativa -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ============================== -->
                <!-- PESTAÑAS TIPO EXCEL            -->
                <!-- ============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tabLogin"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Iniciar Sesión"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/tabRegistro"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Registrarse"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- Campos de texto compartidos y adaptativos -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress"
                    android:background="?android:attr/colorBackground"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:drawableStart="@android:drawable/ic_dialog_email"
                    android:drawablePadding="12dp"
                    android:layout_marginBottom="16dp"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textColor="?android:attr/textColorPrimary"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:background="?android:attr/colorBackground"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:drawableStart="@android:drawable/ic_secure"
                    android:drawablePadding="12dp"
                    android:layout_marginBottom="16dp"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textColor="?android:attr/textColorPrimary"/>

                <!-- ============================== -->
                <!-- CONTENEDOR 1: INICIAR SESIÓN   -->
                <!-- ============================== -->
                <LinearLayout
                    android:id="@+id/layoutLoginActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRecuperarPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="#1E88E5"
                        android:gravity="end"
                        android:layout_marginBottom="24dp"
                        android:textStyle="bold"/>

                    <!-- BOTÓN HEXAGONAL -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="INICIAR SESIÓN"
                        android:background="@drawable/bg_hexagono2"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- ============================== -->
                <!-- CONTENEDOR 2: CREAR CUENTA     -->
                <!-- ============================== -->
                <LinearLayout
                    android:id="@+id/layoutRegistroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- BOTÓN HEXAGONAL -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegistrar"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="CREAR NUEVA CUENTA"
                        android:background="@drawable/bg_hexagono2"
                        android:backgroundTint="#FFCB05"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>