<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- TÍTULO DEL DIÁLOGO (Correcto o Incorrecto) -->
        <TextView
            android:id="@+id/txtDialogTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Correcto!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="16dp" />

        <!-- MENSAJE CON LOS TIPOS -->
        <TextView
            android:id="@+id/txtDialogMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Era de tipo..."
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- BOTÓN PARA CONTINUAR -->
        <Button
            android:id="@+id/btnDialogSiguiente"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Siguiente Pokémon"
            android:backgroundTint="#FFCB05"
            android:textColor="#333333"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.cardview.widget.CardView>